<style>
/* Navbar Base Styles - Higher Specificity */
nav.navbar {
    padding: 0.75rem 1rem !important;
    background-color: white !important;
}

.navbar-brand {
    font-size: 1.5rem;
    padding: 0;
}

.fa-compass {
    color: #fe242d;
    font-size: 2rem;
}

.navbar .nav-link {
    color: #222222 !important;
    padding: 0.5rem 1rem !important;
    font-size: 0.95rem;
}

.navbar .nav-link:hover {
    color: #fe242d !important;
}

/* Search Button Styles */
.search-btn {
    background-color: #fe242d !important;
    color: #fff !important;
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    border: none;
    white-space: nowrap;
    font-weight: 500;
}

.search-btn:hover {
    background-color: #e21e26 !important;
    color: #fff !important;
}

.search-btn i {
    display: inline;
    margin-right: 0.5rem;
}

.search-inp {
    border-radius: 25px;
    padding: 0.5rem 1.5rem;
    font-size: 0.95rem;
    border: 1px solid #ddd;
}

.search-inp:focus {
    border-color: #fe242d;
    box-shadow: 0 0 0 0.2rem rgba(254, 36, 45, 0.15);
}

/* Desktop Styles (769px and above) */
@media (min-width: 769px) {
    nav.navbar {
        padding: 0.75rem 2rem !important;
    }
    
    .navbar .navbar-nav {
        align-items: center;
    }
    
    .navbar form.d-flex {
        margin: 0 1rem;
    }
}

/* Tablet and Mobile Styles (768px and below) */
@media (max-width: 768px) {
    nav.navbar {
        padding: 0.75rem 1rem !important;
    }
    
    .fa-compass {
        font-size: 1.75rem;
    }
    
    /* Stack navbar items vertically on mobile */
    .navbar-collapse {
        margin-top: 1rem;
    }
    
    .navbar .navbar-nav {
        width: 100% !important;
        margin-bottom: 1rem !important;
        margin-left: 0 !important;
    }
    
    .navbar .navbar-nav.ms-auto {
        margin-left: 0 !important;
    }
    
    .navbar .nav-link {
        padding: 0.75rem 0.5rem !important;
        display: block;
        width: 100%;
    }
    
    /* Search form full width on mobile */
    .navbar form.d-flex {
        width: 100% !important;
        flex-direction: column !important;
        gap: 0.75rem;
        margin-bottom: 1rem;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    
    .navbar .search-inp {
        width: 100% !important;
        margin: 0 !important;
        padding: 0.75rem 1.25rem;
        font-size: 1rem;
    }
    
    .navbar .search-btn {
        width: 100% !important;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        margin: 0 !important;
    }
    
    .search-btn i {
        margin-right: 0.5rem;
    }
    
    /* Add spacing between navigation sections */
    .navbar .navbar-nav + .navbar-nav {
        padding-top: 0.5rem;
        border-top: 1px solid #f0f0f0;
        margin-top: 0.5rem;
    }
    
    /* Ensure proper spacing for auth links */
    .navbar .navbar-nav:last-child {
        padding-bottom: 0.5rem;
    }
}

/* Small Mobile Styles (480px and below) */
@media (max-width: 480px) {
    nav.navbar {
        padding: 0.5rem 0.75rem !important;
    }
    
    .fa-compass {
        font-size: 1.5rem;
    }
    
    .navbar .nav-link {
        padding: 0.6rem 0.5rem !important;
        font-size: 0.95rem;
    }
    
    .navbar .search-inp {
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
    }
    
    .navbar .search-btn {
        padding: 0.7rem 1.25rem;
        font-size: 0.95rem;
    }
}

/* Navbar Toggler */
.navbar-toggler {
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    padding: 0.5rem 0.75rem;
}

.navbar-toggler:focus {
    box-shadow: none !important;
    border-color: #fe242d !important;
}

/* Improve touch targets on mobile */
@media (max-width: 768px) {
    .navbar .nav-link,
    .navbar .search-btn {
        min-height: 44px;
        display: flex;
        align-items: center;
    }
    
    .navbar .nav-link {
        justify-content: flex-start;
    }
    
    .navbar .search-btn {
        justify-content: center;
    }
}
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass"></i></a>
    <button 
        class="navbar-toggler" 
        type="button" 
        data-bs-toggle="collapse" 
        data-bs-target="#navbarNavAltMarkup" 
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 search-inp" type="search" placeholder="Search Destinations" />
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if(!currUser) {%>
        <a class="nav-link" href="/signup"><b>Signup</b></a>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <% } %>
        <% if(currUser) {%>
        <a class="nav-link" href="/logout"><b>Logout</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>